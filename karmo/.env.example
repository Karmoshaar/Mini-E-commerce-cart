# ===== مطلوب =====
# توكن البوت: https://discord.com/developers/applications ← تطبيقك ← Bot ← Reset Token
DISCORD_TOKEN=

# ===== اختياري =====
# اسم البوت: بيغيّر اسمو لحالو لهالاسم أول ما يشتغل
BOT_NAME=Karmo

# بادئة الأوامر (مثلاً !p)
PREFIX=!

# لما تخلص القائمة، كمّل بأغاني من نفس النمط (true/false)
AUTOPLAY=true

# الصوت الافتراضي (0-200)
DEFAULT_VOLUME=80

# بعد كم ثانية يطلع البوت من الروم إذا ما في شي يشتغل أو ما ضل حدا
IDLE_TIMEOUT_SECONDS=180

# آيدي سيرفرك: بخلي أوامر / تظهر فوراً بهذا السيرفر
GUILD_ID=

# أقصى عدد أغاني بالقائمة / أقصى عدد أغاني بينقرأ من بلاي ليست
MAX_QUEUE=500
MAX_PLAYLIST=200

# إذا يوتيوب قال "Sign in to confirm you're not a bot" (شوف README)
# YTDLP_COOKIES=cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=firefox

# مسارات خاصة (عادةً ما بتحتاجها، البوت بينزّلهم لحاله)
# YTDLP_PATH=
# FFMPEG_PATH=

# DEBUG=true
